# Node stuff
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Git
.git/
.gitignore

# OS files
.DS_Store
Thumbs.db

# Build outputs
dist/
.nyc_output
coverage/
.cache/
.parcel-cache/

# Local environment
.env
.env.*
!.env.example  # keep env.example for reference

# Don’t copy host vendor (will be installed in Docker)
vendor/

# Keep storage/bootstrap, but we’ll mount them as volumes
# (so don’t ignore them!)

# Avoid Windows symlink issues in build context
public/storage

